<?xml version='1.0' encoding='UTF-8'?>
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="./eVED/eVED_3D.net.xml" />
        <route-files value="../custom/eVED/custom.rou.xml" />
        <additional-files value="../custom/vehicle_types.add.xml" />
    </input>

    <output>
        <tripinfo-output value="../output/eVED/tripinfos.xml" />
    </output>

    <time>
        <step-length value="1.0" />
        <end value="40000.00" />
    </time>

    <processing>
        <seed value="42" />
        <threads value="1" />
        <ignore-route-errors value="true" />
        <tls.actuated.jam-threshold value="30" />
        <collision.action value="none" />
    </processing>

    <routing>
        <device.rerouting.adaptation-steps value="18" />
        <device.rerouting.adaptation-interval value="10" />
    </routing>

    <report>
        <verbose value="true" />
        <duration-log.statistics value="true" />
        <no-step-log value="true" />
    </report>

</sumoConfiguration>